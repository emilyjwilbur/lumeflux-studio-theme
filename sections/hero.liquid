<div class="width">
    <section class="hero-overlap">
      <div class="hero-left">
        <h1 class="hero-heading" style="font-size: {% if section.settings.heading_font_size == 'small' %} 1rem {% elsif section.settings.heading_font_size == 'medium' %} 2.1rem {% else %} 3rem {% endif %};">
          {{ section.settings.heading }}
        </h1>
        <p>{{ section.settings.subheading }}</p>
        <a href="{{ section.settings.button_link }}" class="hero-button">
          {{ section.settings.button_label }}
        </a>
      </div>
  
      <div class="hero-right">
        <!-- This div is now only structural -->
      </div>
    
      {% if section.settings.right_image != blank %}
        <img width="" height=""
          src="{{ section.settings.right_image | img_url: 'master' }}" 
          alt="Right Hero Image" 
          class="right-image"
        >
      {% endif %}
    
      {% if section.settings.circle_image != blank %}
        <div class="circle-wrapper">
          <img width="" height=""
            src="{{ section.settings.circle_image | img_url: 'master' }}" 
            alt="Circle Image" 
            class="circle-image"
          >
        </div>
      {% endif %}
    </section>
  </div>
  




  {% schema %}
  {
    "name": "Hero - Overlapping Images",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Radiant Skincare for Every Skin"
      },
      {
        "type": "textarea",
        "id": "subheading",
        "label": "Subheading",
        "default": "Glow Naturally with Lumeflux"
      },
      {
        "type": "image_picker",
        "id": "circle_image",
        "label": "Middle Circle Image"
      },
      {
        "type": "image_picker",
        "id": "right_image",
        "label": "Right Hero Image"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button Link"
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button Label",
        "default": "Shop Lumeflux"
      },
      {
        "type": "radio",
        "id": "heading_font_size",
        "label": "Heading Font Size",
        "default": "medium",
        "options": [
          {
            "value": "small",
            "label": "Small"
          },
          {
            "value": "medium",
            "label": "Medium"
          },
          {
            "value": "large",
            "label": "Large"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Hero - Overlapping Images"
      }
    ]
  }
  {% endschema %}
  
