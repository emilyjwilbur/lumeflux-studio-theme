{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "text",
      "label": "Hero Title",
      "id": "hero_title",
      "default": "Welcome to Our Store!"
    },
    {
      "type": "textarea",
      "label": "Hero Description",
      "id": "hero_description",
      "default": "Browse our exclusive collection of products."
    },
    {
      "type": "image_picker",
      "label": "Hero Background Image",
      "id": "hero_background_image"
    },
    {
      "type": "text",
      "label": "Call to Action Text",
      "id": "hero_cta_text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "label": "Call to Action Link",
      "id": "hero_cta_link",
      "default": "/collections"
    }
  ]
}
{% endschema %}

<section class="hero-section" style="background-image: url('{{ settings.hero_image | img_url: '1600x' }}');">
  <div class="hero-overlay">
    <div class="hero-content">
      <h1 class="hero-heading">{{ settings.hero_heading }}</h1>
      <p class="hero-subheading">{{ settings.hero_subheading }}</p>
      <a href="{{ settings.hero_button_url }}" class="hero-button">{{ settings.hero_button_text }}</a>
    </div>
  </div>
</section>
