<section class="hero-overlap-section">
    <div class="hero-overlap-content">
      <div class="hero-left">
        <h1>{{ section.settings.heading }}</h1>
        <p>{{ section.settings.subheading }}</p>
        <a href="{{ section.settings.button_link }}" class="hero-button">
          {{ section.settings.button_label }}
        </a>
      </div>
  
      <div class="hero-right">
        {% if section.settings.right_image != blank %}
          <img width="" height="" src="{{ section.settings.right_image | img_url: 'master' }}" alt="Hero Image" class="hero-image-right" />
        {% endif %}
  
        {% if section.settings.circle_image != blank %}
          <div class="circle-wrapper">
            <img width="" height="" src="{{ section.settings.circle_image | img_url: 'master' }}" alt="Circle Image" class="circle-image" />
          </div>
        {% endif %}
      </div>
    </div>
  </section>
  
  




{% schema %}
{
  "name": "Hero - Overlapping Images",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Revival of Health"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Transform your health starting at its foundation..."
    },
    {
      "type": "image_picker",
      "id": "circle_image",
      "label": "Middle Circle Image"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Hero Image"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop ARMRA"
    }
  ]
}
{% endschema %}
