<div class="width">
    <div class="header-flex">
      <!-- LEFT: Navigation -->
      <div class="header-left">
        <ul class="header-nav">
            {% for link in section.settings.navigation.links %}
                <li class="header-nav-item">
                    <a class="header-nav-anchor" href="{{ link.url }}">
                        {{ link.title }}
                        {% if link.links != blank %}
                          <!-- Add the caret next to items with dropdowns -->
                          <span class="caret"></span>
                        {% endif %}
                      </a>
                  {% if link.links != blank %}
                    
                    <ul class="header-sub">
                        {% for child in link.links %}
                            <li class="header-sub-item">
                                <a href="{{ child.url }}" class="header-sub-anchor">{{ child.title }}</a>
                              
                                {% if child.links != blank %}
                                  <button class="header-sub-sub-toggle" aria-label="Toggle submenu">▼</button>
                                  <ul class="header-sub-sub">
                                    {% for grandchild in child.links %}
                                      <li class="header-sub-sub-item">
                                        <a href="{{ grandchild.url }}" class="header-sub-sub-anchor">{{ grandchild.title }}</a>
                                      </li>
                                    {% endfor %}
                                  </ul>
                                {% endif %}
                              </li>
                              
                              
                              
                          {% endfor %}
                          
                    </ul>
                  {% endif %}
                </li>
              {% endfor %}
        </ul>
      </div>
  
      <!-- CENTER: Logo -->
      <div class="header-center">
        <a href="/" class="header-logo">
          <img width="" height="" src="{{ section.settings.logo | img_url: 'master' }}" alt="{{ shop.name }}">
        </a>
      </div>
  
      <!-- RIGHT: Login + Cart + Hamburger -->
      <div class="header-right">
        {% if section.settings.show_login %}
          <a href="/account" class="header-action login">Login</a>
        {% endif %}
        {% if section.settings.show_cart %}
          <a href="/cart" class="header-action cart">Cart</a>
        {% endif %}
        <button class="header-hamburger">
          <span class="header-hamburger-bar"></span>
          <span class="header-hamburger-bar"></span>
          <span class="header-hamburger-bar"></span>
        </button>
      </div>
    </div>
  </div>
  
  
<div class="header-nav-overlay"></div>
<style>
    .header{
    padding: {{ section.settings.padding }}px 0;
    background: #ffffff;
}
.header-logo{
    max-width: {{ section.settings.logo_width }}px;
}
.header-sub {
    padding: 0 20px;
    margin-top: 15px;
  }

  /* For screens 1200px and above */
  @media (min-width: 1200px) {
    .header-sub {
      position: absolute;
      top: 100%;
      transform: translateX(-50%);
      background: {{ settings.header-sub | default: '#c7d8d5' }};
      border-radius: 0px;
      width: 200px;
      padding: 20px;
      opacity: 0;
      left: -9999px;
      transition: left 0s 0.4s, opacity 0.4s;
     
    }
  }
   /* .header-sub-sub styling for desktop */
   .header-sub-sub {
    position: absolute;
    top: 0;
    left: calc(100%); /* Position the sub-sub menu to the right of the parent */
    background: {{ settings.header-sub | default: '#c7d8d5' }}; /* Same background as .header-sub */
    border-radius: 0px;
    width: 200px;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0s 0.3s;
  }

  /* Make the sub-sub menu visible on hover */
  .header-sub-item:hover .header-sub-sub,
  .header-sub-sub:hover {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
}
</style>
<script>
    document.querySelector('.header-hamburger').addEventListener('click', () => {
        document.querySelector('.header').classList.toggle('nav-active');
      });
      document.querySelector('.header-nav-overlay').addEventListener('click', () => {
        document.querySelector('.header').classList.remove('nav-active');
      });
      
      document.addEventListener("DOMContentLoaded", function () {
        if (window.innerWidth >= 1200) {
          document.querySelectorAll(".header-sub-sub-toggle").forEach((toggle) => {
            toggle.addEventListener("click", function (e) {
              e.preventDefault();
              const parentItem = toggle.closest(".header-sub-item");
    
              // Close other open sub-sub-menus
              document.querySelectorAll(".header-sub-item").forEach((item) => {
                if (item !== parentItem) {
                  item.classList.remove("sub-sub-open");
                }
              });
    
              // Toggle this one
              parentItem.classList.toggle("sub-sub-open");
            });
          });
        }
      });
      
</script>
{% schema %}
{
"name": "Header",
"tag": "header",
"class":"header",
"settings": [
    {
        "type": "range",
        "id": "padding",
        "label": "Header Height",
        "default": 24,
        "min": 5,
        "max": 100,
        "step": 1
      },
    {
    "type": "image_picker",
    "id": "logo",
    "label": "Logo"
    }, 
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo Width",
        "default": 100,
        "min": 20,
        "max": 300,
        "step": 5
      },
      {
        "type": "link_list",
        "id": "navigation",
        "label": "Navigation menu",
        "default": "main-menu"
    },
    {
        "type": "color",
        "id": "header-sub",
        "label": "Dropdown Background Color",
        "default": "#c7d8d5"
      },
    {
        "type": "checkbox",
        "id": "show_login",
        "label": "Show Login Button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_cart",
        "label": "Show Cart Button",
        "default": true
      }
]
}
{% endschema %}
