<div class="width">
    <div class="header-flex">
      <!-- LEFT: Navigation -->
      <div class="header-left">
        <ul class="header-nav">
            {% for link in section.settings.navigation.links %}
                <li class="header-nav-item">
                  <a class="header-nav-anchor" href="{{ link.url }}">{{ link.title }}</a>
                  {% if link.links != blank %}
                    <ul class="header-sub">
                      {% for child in link.links %}
                        <li class="header-sub-item">
                          <a href="{{ child.url }}" class="header-sub-anchor">{{ child.title }}</a>
                          {% if child.links != blank %}
                            <ul class="header-sub-sub">
                              {% for grandchild in child.links %}
                                <li class="header-sub-sub-item">
                                  <a href="{{ grandchild.url }}" class="header-sub-sub-anchor">{{ grandchild.title }}</a>
                                </li>
                              {% endfor %}
                            </ul>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </li>
              {% endfor %}
        </ul>
      </div>
  
      <!-- CENTER: Logo -->
      <div class="header-center">
        <a href="/" class="header-logo">
          <img width="" height="" src="{{ section.settings.logo | img_url: 'master' }}" alt="{{ shop.name }}">
        </a>
      </div>
  
      <!-- RIGHT: Login + Cart + Hamburger -->
      <div class="header-right">
        {% if section.settings.show_login %}
          <a href="/account" class="header-action login">Login</a>
        {% endif %}
        {% if section.settings.show_cart %}
          <a href="/cart" class="header-action cart">Cart</a>
        {% endif %}
        <button class="header-hamburger">
          <span class="header-hamburger-bar"></span>
          <span class="header-hamburger-bar"></span>
          <span class="header-hamburger-bar"></span>
        </button>
      </div>
    </div>
  </div>
  
  
<div class="header-nav-overlay"></div>
<style>
    .header{
    padding: {{ section.settings.padding }}px 0;
}
.header-logo{
    max-width: {{ section.settings.logo_width }}px;
}
</style>
<script>
    document.querySelector('.header-hamburger').addEventListener('click', () => {
        document.querySelector('.header').classList.toggle('nav-active');
      });
      document.querySelector('.header-nav-overlay').addEventListener('click', () => {
        document.querySelector('.header').classList.remove('nav-active');
      });
      
</script>
{% schema %}
{
"name": "Header",
"tag": "header",
"class":"header",
"settings": [
    {
        "type": "range",
        "id": "padding",
        "label": "Header Height",
        "default": 24,
        "min": 5,
        "max": 100,
        "step": 1
      },
    {
    "type": "image_picker",
    "id": "logo",
    "label": "Logo"
    }, 
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo Width",
        "default": 100,
        "min": 20,
        "max": 300,
        "step": 5
      },
      {
        "type": "link_list",
        "id": "navigation",
        "label": "Navigation menu",
        "default": "main-menu"
    },
    {
        "type": "checkbox",
        "id": "show_login",
        "label": "Show Login Button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_cart",
        "label": "Show Cart Button",
        "default": true
      }
]
}
{% endschema %}
